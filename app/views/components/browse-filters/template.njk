{%- set containerClasses = [params.classes] if params.classes else [] -%}
{%- set classes = containerClasses | join(' ') -%}
<ul class="tna-browse-filters{% if classes %} {{ classes }}{% endif %}" data-module="tna-browse-filters"{% for attribute, value in params.attributes %} {{ attribute }}{% if value !== '' %}="{{ value }}"{% endif %}{% endfor %}>
  {%- for item in params.items %}
  <li class="tna-browse-filters__item{% if item.selected %} tna-browse-filters__item--selected{% endif %}">
    <button type="button" class="tna-browse-filters__toggle" aria-pressed="{{ 'true' if item.selected else 'false' }}">{{ item.label }}</button>
    <button type="button" class="tna-browse-filters__remove" aria-label="Remove {{ item.label }} filter"></button>
  </li>
  {%- endfor %}
</ul>
