{%- set containerClasses = [params.classes] if params.classes else [] -%}
{%- set classes = containerClasses | join(' ') -%}
{%- set bannerId = params.id if params.id else "tna-notice-banner" -%}
<section class="tna-notice-banner{% if classes %} {{ classes }}{% endif %}" aria-labelledby="{{ bannerId }}__heading"{% for attribute, value in params.attributes %} {{ attribute }}{% if value !== '' %}="{{ value }}"{% endif %}{% endfor %}>
  <h{{ params.headingLevel or '2' }} class="tna-heading-s tna-notice-banner__heading" id="{{ bannerId }}__heading">{{ params.title }}</h{{ params.headingLevel or '2' }}>
  <div class="tna-notice-banner__content">
    {{ params.body | safe }}
  </div>
</section>
